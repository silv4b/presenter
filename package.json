    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "react-pdf": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
