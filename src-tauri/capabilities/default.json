{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the presenter main window and the projection (viewscreen) window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default"
  ]
}

